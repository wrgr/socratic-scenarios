{
  "name": "socratic-scenarios",
  "license": "Apache-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "npx tsx scripts/ingest-corpus.ts",
    "scrub:kb": "npx tsx scripts/scrub-kb.ts",
    "colreg:llm-eval": "npx tsx scripts/colreg-llm-eval.ts",
    "learner:recovery": "npx tsx scripts/learner-recovery.ts",
    "colreg:leakage": "npx tsx scripts/colreg-leakage.ts",
    "db:init": "npx tsx scripts/db/init.ts",
    "db:migrate": "npx tsx scripts/db/migrate.ts",
    "db:retrieve-report-sources": "npx tsx scripts/db/retrieve-report-sources.ts",
    "db:export": "npx tsx scripts/db/export.ts",
    "db:ingest-kb": "npx tsx scripts/db/ingest-kb.ts",
    "db:refresh-embeddings": "npx tsx scripts/db/refresh-embeddings.ts",
    "db:validate": "npx tsx scripts/db/validate.ts",
    "db:add-elicitation": "npx tsx scripts/db/add-elicitation.ts",
    "db:log-failure": "npx tsx scripts/db/log-failure.ts",
    "db:ingest-sources": "npx tsx scripts/db/ingest-sources.ts",
    "db:setup": "npm run db:init && npm run db:migrate && npm run db:ingest-kb && npm run db:validate",
    "db:full-setup": "npm run db:init && npm run db:migrate && npm run db:ingest-kb && npm run db:ingest-sources && npm run db:refresh-embeddings && npm run db:export && npm run db:validate",
    "build:whitepaper": "bash scripts/build-whitepaper.sh",
    "colreg:construct": "npx tsx scripts/colreg-construct-validity.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@xyflow/react": "^12.10.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "js-yaml": "^4.1.1",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  }
